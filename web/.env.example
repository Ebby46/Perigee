# ============================================================
#  Perigee — environment variables template
#  Copy this file to .env.local and fill in the values.
#  .env.local is git-ignored and must never be committed.
#
#  Last audited: see WEB-30 (#116) — all NEXT_PUBLIC_* env
#  vars consumed by the web/ app are documented here.
# ============================================================

# ------------------------------------------------------------
# Backend API
# ------------------------------------------------------------
# Base URL of the Perigee analyzer backend.
# Local dev defaults to http://localhost:8080 if unset.
# In production set this to the deployed backend URL.
NEXT_PUBLIC_API_URL=http://localhost:8080

# ------------------------------------------------------------
# Stellar network
# Set to "local", "testnet", or "mainnet" / "public".
# Drives wallet-kit network selection and stage guards.
# ------------------------------------------------------------
NEXT_PUBLIC_STELLAR_NETWORK=local

# ------------------------------------------------------------
# Feature flags
# Set to "true" to enable; any other value (or unset) disables.
# ------------------------------------------------------------
# Enable Vercel Analytics (web/components/Analytics.tsx).
# Should be set to "true" only in Vercel production deployments.
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Enable verbose client-side logging (web/lib/logger.ts).
# Leave unset in production to suppress debug output.
NEXT_PUBLIC_DEBUG_LOGGING=false

# ============================================================
#  Contract IDs — one block per stage
#  Deploy scripts write the testnet block to .env.testnet.
#  CI/CD writes the mainnet block to Vercel env vars.
# ============================================================

# ------------------------------------------------------------
# LOCAL  (stellar-quickstart / local sandbox)
# Run  to spin up a local node.
# These IDs are assigned by your local deploy; update freely.
# ------------------------------------------------------------
NEXT_PUBLIC_CONTRACT_POLICY_VAULT=
NEXT_PUBLIC_CONTRACT_STRATEGY_TRIGGER=
NEXT_PUBLIC_CONTRACT_FEE_ACCRUAL=
NEXT_PUBLIC_CONTRACT_EMERGENCY_GUARD=
NEXT_PUBLIC_CONTRACT_LIQUIDITY_POOL=
NEXT_PUBLIC_CONTRACT_TOKEN=
NEXT_PUBLIC_CONTRACT_ORACLE_AGGREGATOR=
NEXT_PUBLIC_CONTRACT_CROSS_CHAIN_VERIFIER=
NEXT_PUBLIC_CONTRACT_HELLO_SOROBAN=

# ------------------------------------------------------------
# TESTNET  (Soroban Testnet — Test SDF Network ; September 2015)
# Written automatically by scripts/deploy_testnet.sh into .env.testnet.
# Source that file or copy the values here for local testnet dev.
# ------------------------------------------------------------
# NEXT_PUBLIC_CONTRACT_POLICY_VAULT=
# NEXT_PUBLIC_CONTRACT_STRATEGY_TRIGGER=
# NEXT_PUBLIC_CONTRACT_FEE_ACCRUAL=
# NEXT_PUBLIC_CONTRACT_EMERGENCY_GUARD=
# NEXT_PUBLIC_CONTRACT_LIQUIDITY_POOL=
# NEXT_PUBLIC_CONTRACT_TOKEN=
# NEXT_PUBLIC_CONTRACT_ORACLE_AGGREGATOR=
# NEXT_PUBLIC_CONTRACT_CROSS_CHAIN_VERIFIER=
# NEXT_PUBLIC_CONTRACT_HELLO_SOROBAN=

# ------------------------------------------------------------
# MAINNET  (Stellar Public Network)
# Set these in your hosting provider (Vercel / Fly.io / etc.)
# as encrypted environment variables — never commit them.
# ------------------------------------------------------------
# NEXT_PUBLIC_CONTRACT_POLICY_VAULT=
# NEXT_PUBLIC_CONTRACT_STRATEGY_TRIGGER=
# NEXT_PUBLIC_CONTRACT_FEE_ACCRUAL=
# NEXT_PUBLIC_CONTRACT_EMERGENCY_GUARD=
# NEXT_PUBLIC_CONTRACT_LIQUIDITY_POOL=
# NEXT_PUBLIC_CONTRACT_TOKEN=
# NEXT_PUBLIC_CONTRACT_ORACLE_AGGREGATOR=
# NEXT_PUBLIC_CONTRACT_CROSS_CHAIN_VERIFIER=
# NEXT_PUBLIC_CONTRACT_HELLO_SOROBAN=
